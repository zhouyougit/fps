{
  "name": "saltline",
  "version": "0.54.0",
  "private": true,
  "description": "几猫 · SALTLINE 单文件战术射击（V32-V54 版本线）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs game.html v54 --minify",
    "build:release": "node tools/build.cjs \"versions/几猫_V54.html\" v54 --minify",
    "test:lint": "node tools/lint_tests.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:server": "node server/test_profiles.cjs && node server/test_round.cjs && node server/test_net2.cjs",
    "test:fast": "node tools/run_tests.mjs fast",
    "test:full": "node tools/run_tests.mjs full",
    "test:domain": "node tools/run_tests.mjs",
    "test:perf": "node tools/test_v41_perf.mjs",
    "test:config": "node --test tests/unit/config.test.mjs",
    "test:avatar": "node tools/test_v43_avatar.mjs",
    "test:drone": "node tools/test_v44_drone.mjs",
    "test:release": "node tools/test_v46_map_release.mjs",
    "test:autoq": "node tools/test_v50_quality_auto.mjs",
    "test:enemy-shadow": "node tools/test_v51_enemy_shadow.mjs",
    "test:arch": "node --test tests/unit/architecture.test.mjs",
    "test:v53": "node tools/test_v53_acceptance.mjs",
    "test:v54": "node tools/test_v54_acceptance.mjs",
    "serve:test": "node tools/serve.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "terser": "^5.51.2"
  }
}
